          "description": "Check the points earned.",
          "capabilities": [
            { "name": "See loyalty balance", "takes": "nothing", "gives": "the balance", "interfaces": ["mobile app"], "acts": [{ "mode": "observes", "resource": "Loyalty balance" }] }
          ]
