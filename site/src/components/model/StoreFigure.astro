---
// Page 02: one boundary of the Store, drawn, with a numbered key to the model's terms. Concept
// names show as code, written with backticks in the descriptions.
import { inline } from "../inline";

const terms = [
  ["Consumer", "The person or system that uses the `provider` to get something done."],
  ["Interface", "The channel the `consumer` uses."],
  ["Provider", "What the `consumer` believes it is using."],
  ["Boundary", "Where the `provider` offers `resources` and `capabilities` to the `consumer`."],
  ["Area", "`Capabilities` that serve one purpose, `core` or `supporting`."],
  ["Capability", "Something the `consumer` can do, to get a result."],
  ["Resource", "Something with a state the `consumer` cares about."],
  ["Component", "A part of a `provider` with its own state or decisions."],
  ["Outside service", "A service outside the system that a `component` calls."],
];
const markers = [
  [86, 131],
  [106, 120],
  [120, 8],
  [120, 230],
  [362, 114],
  [292, 177],
  [446, 258],
  [516, 210],
  [666, 210],
];
---

<figure class="fig not-content">
  <div class="scrollx">
    <svg viewBox="-10 -10 700 322" role="img" aria-label="The Store example. The Shopper uses the Store through the web shop and the mobile app, to Shop and to See loyalty balance. Inside the Store: Storefront and Payments, and Payments uses the Card network.">
      <text class="s-k" x="0" y="20">LEVEL 1</text>
      <rect class="s-box" x="0.5" y="131" width="86" height="48" rx="3"></rect>
      <text class="s-k" x="10" y="148">CONSUMER</text>
      <text class="s-n" x="10" y="166">Shopper</text>
      <path class="s-line" d="M86.5 155 C104 155 104 135 120 135"></path>
      <path class="s-line" d="M86.5 155 C104 155 104 181 120 181"></path>
      <rect class="s-frame" x="120" y="8" width="558" height="294" rx="2"></rect>
      <text class="s-k" x="134" y="30">PROVIDER</text>
      <text class="s-n" x="134" y="48">Store</text>
      <text class="s-s" x="134" y="64">The shop as shoppers know it, on the web and in the mobile app.</text>
      <line class="s-rule" x1="121" y1="78" x2="677" y2="78"></line>
      <text class="s-k" x="130" y="100">INTERFACES</text>
      <text class="s-k" x="212" y="100">CAPABILITIES</text>
      <text class="s-k" x="388" y="100">COMPONENTS · LEVEL 2</text>
      <circle class="s-dot" cx="120" cy="135" r="4"></circle>
      <circle class="s-dot" cx="120" cy="181" r="4"></circle>
      <text class="s-s" x="130" y="139">web shop</text>
      <text class="s-s" x="130" y="185">mobile app</text>
      <path class="s-line" d="M180 135 C196 135 196 165 212 165"></path>
      <path class="s-line" d="M188 181 C200 181 200 165 212 165"></path>
      <path class="s-line" d="M188 181 C200 181 200 252 212 252"></path>
      <rect class="s-area" x="212" y="114" width="150" height="98" rx="3"></rect>
      <text class="s-k" x="222" y="130">CORE AREA</text>
      <text class="s-n" x="222" y="147">Shop</text>
      <text class="s-s" x="222" y="166">Browse products</text>
      <text class="s-s" x="222" y="181">Place order</text>
      <text class="s-s" x="222" y="196">List past orders</text>
      <rect class="s-area" x="212" y="226" width="150" height="52" rx="3"></rect>
      <text class="s-k" x="222" y="242">SUPPORTING AREA</text>
      <text class="s-n" x="222" y="260">See loyalty balance</text>
      <path class="s-line" d="M362 165 C375 165 375 151 388 151"></path>
      <path class="s-line" d="M362 165 C375 165 375 243 388 243"></path>
      <path class="s-line" d="M362 252 C375 252 375 151 388 151"></path>
      <rect class="s-box" x="388" y="114" width="128" height="74" rx="3"></rect>
      <text class="s-k" x="398" y="130">COMPONENT</text>
      <text class="s-n" x="398" y="148">Storefront</text>
      <text class="s-r" x="398" y="165">Product · Order</text>
      <text class="s-r" x="398" y="179">Loyalty balance</text>
      <line class="s-line" x1="452" y1="188" x2="452" y2="210"></line>
      <rect class="s-box" x="388" y="210" width="128" height="66" rx="3"></rect>
      <text class="s-k" x="398" y="226">COMPONENT</text>
      <text class="s-n" x="398" y="244">Payments</text>
      <text class="s-r" x="398" y="262">Charge</text>
      <line class="s-line" x1="516" y1="243" x2="536" y2="243"></line>
      <rect class="s-out" x="536" y="210" width="130" height="66" rx="3"></rect>
      <text class="s-k" x="546" y="226">OUTSIDE SERVICE</text>
      <text class="s-n" x="546" y="244">Card network</text>
      <text class="s-r" x="546" y="262">Card authorization</text>
      {
        markers.map(([x, y], i) => (
          <g class="s-mk">
            <circle cx={x} cy={y} r="8" />
            <text x={x} y={y}>
              {i + 1}
            </text>
          </g>
        ))
      }
    </svg>
  </div>
  <ol class="terms">
    {
      terms.map(([name, about], i) => (
        <li>
          <span class="b">{i + 1}</span>
          <div>
            <b>
              <code>{name}</code>
            </b>
            <span set:html={inline(about)} />
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .fig {
    margin: 18px 0 0;
    padding: 16px 16px 14px;
    border: 1px solid var(--bm-line);
    border-radius: 12px;
  }
  .scrollx {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 540px;
    height: auto;
  }
  .s-frame {
    fill: none;
    stroke: var(--bm-fg);
    stroke-width: 1.4;
  }
  .s-rule {
    stroke: var(--bm-line);
    stroke-width: 1;
  }
  .s-box {
    fill: var(--bm-bg);
    stroke: var(--bm-line2);
    stroke-width: 1;
  }
  .s-area {
    fill: var(--bm-panel);
    stroke: var(--bm-line2);
    stroke-width: 1;
  }
  .s-out {
    fill: var(--bm-bg);
    stroke: var(--bm-fg3);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  .s-line {
    fill: none;
    stroke: var(--bm-fg4);
    stroke-width: 1;
  }
  .s-dot {
    fill: var(--bm-bg);
    stroke: var(--bm-fg);
    stroke-width: 1.4;
  }
  .s-k {
    fill: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
  }
  .s-n {
    fill: var(--bm-fg);
    font-family: var(--__sl-font);
    font-size: 12.5px;
    font-weight: 600;
  }
  .s-s {
    fill: var(--bm-fg2);
    font-family: var(--__sl-font);
    font-size: 10.5px;
  }
  .s-r {
    fill: var(--bm-fg2);
    font-family: var(--__sl-font-mono);
    font-size: 9.5px;
  }
  .s-mk circle {
    fill: var(--bm-fg);
  }
  .s-mk text {
    fill: var(--bm-bg);
    font-family: var(--__sl-font-mono);
    font-size: 9px;
    font-weight: 500;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 22px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .terms li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
  }
  .terms .b {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--bm-fg);
    color: var(--bm-bg);
    font-family: var(--__sl-font-mono);
    font-size: 10px;
  }
  .terms b {
    display: block;
    color: var(--bm-fg);
    font-size: 13.5px;
    font-weight: 600;
  }
  .terms div span {
    display: block;
    color: var(--bm-fg2);
    font-size: 13px;
    line-height: 1.5;
  }
  @media (max-width: 40rem) {
    .terms {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
