---
// Page 02: the Store, drawn one concept at a time, in the same grammar as the Store figure above
// it. Each `step` draws one small picture: the Store alone, who uses it, through which interfaces,
// what they can do, what that acts on, the components inside it, and the same pattern one level
// down.
interface Props {
  step: "store" | "consumers" | "interfaces" | "capabilities" | "resources" | "components" | "inside";
}
const { step } = Astro.props;
const consumers = ["Shopper", "Fraud analyst", "Store manager"];
---

<figure class="ex not-content">
  {
    step === "store" && (
      <svg class="narrow" viewBox="0 0 300 96" role="img" aria-label="One box, the provider: the Store. Nothing else is drawn yet.">
        <rect class="frame" x="50" y="8" width="200" height="80" rx="4" />
        <text class="k" x="66" y="28">PROVIDER</text>
        <text class="n" x="66" y="48">Store</text>
        <text class="s" x="66" y="66">Home goods, sold online</text>
      </svg>
    )
  }
  {
    step === "consumers" && (
      <svg viewBox="0 0 560 196" role="img" aria-label="Three consumers, the Shopper, the Fraud analyst and the Store manager, each with its own boundary to the same provider, the Store.">
        <text class="k" x="230" y="14" text-anchor="middle">BOUNDARIES</text>
        {consumers.map((name, i) => {
          const y = 26 + i * 56;
          return (
            <g>
              <rect class="box" x="0.5" y={y} width="140" height="44" rx="4" />
              <text class="k" x="12" y={y + 17}>CONSUMER</text>
              <text class="n" x="12" y={y + 34}>{name}</text>
              <path class="line" d={`M141 ${y + 22} L230 ${y + 22}`} />
              <line class="bnd" x1="230" y1={y + 4} x2="230" y2={y + 40} />
              <path class="line" d={`M230 ${y + 22} L320 ${y + 22}`} />
            </g>
          );
        })}
        <rect class="frame" x="320" y="26" width="238" height="156" rx="4" />
        <text class="k" x="336" y="46">PROVIDER</text>
        <text class="n" x="336" y="66">Store</text>
        <text class="s" x="336" y="84">Home goods, sold online</text>
      </svg>
    )
  }
  {
    step === "interfaces" && (
      <svg viewBox="0 0 560 132" role="img" aria-label="The Shopper reaches the Store through two interfaces, the web shop and the mobile app, both on one boundary.">
        <rect class="box" x="0.5" y="44" width="140" height="44" rx="4" />
        <text class="k" x="12" y="61">CONSUMER</text>
        <text class="n" x="12" y="78">Shopper</text>
        <path class="line" d="M141 66 C186 66 186 40 230 40" />
        <path class="line" d="M141 66 C186 66 186 92 230 92" />
        <line class="bnd" x1="230" y1="18" x2="230" y2="114" />
        <circle class="dot" cx="230" cy="40" r="4.5" />
        <circle class="dot" cx="230" cy="92" r="4.5" />
        <text class="s" x="242" y="34">web shop</text>
        <text class="s" x="242" y="86">mobile app</text>
        <path class="line" d="M235 40 L320 40" />
        <path class="line" d="M235 92 L320 92" />
        <text class="k" x="230" y="128" text-anchor="middle">ONE BOUNDARY</text>
        <rect class="frame" x="320" y="18" width="238" height="96" rx="4" />
        <text class="k" x="336" y="38">PROVIDER</text>
        <text class="n" x="336" y="58">Store</text>
      </svg>
    )
  }
  {
    step === "capabilities" && (
      <svg class="mid" viewBox="0 0 460 168" role="img" aria-label="Across its boundary, the Shopper can Browse products, Place order and List past orders.">
        <rect class="box" x="0.5" y="80" width="120" height="44" rx="4" />
        <text class="k" x="12" y="97">CONSUMER</text>
        <text class="n" x="12" y="114">Shopper</text>
        <path class="line" d="M121 102 L170 102" />
        <line class="bnd" x1="170" y1="56" x2="170" y2="150" />
        <path class="line" d="M170 102 C202 102 202 77 234 77" />
        <path class="line" d="M170 102 L234 105" />
        <path class="line" d="M170 102 C202 102 202 133 234 133" />
        <rect class="frame" x="210" y="0.5" width="248" height="166" rx="4" />
        <text class="k" x="226" y="20">PROVIDER</text>
        <text class="n" x="226" y="40">Store</text>
        <text class="k" x="236" y="60">CAPABILITIES</text>
        <rect class="cap" x="234" y="66" width="200" height="22" rx="2" />
        <text class="s strong" x="244" y="81">Browse products</text>
        <rect class="cap" x="234" y="94" width="200" height="22" rx="2" />
        <text class="s strong" x="244" y="109">Place order</text>
        <rect class="cap" x="234" y="122" width="200" height="22" rx="2" />
        <text class="s strong" x="244" y="137">List past orders</text>
      </svg>
    )
  }
  {
    step === "resources" && (
      <svg viewBox="0 0 600 236" role="img" aria-label="Browse products observes Product. List past orders observes Order. Place order produces an Order and mutates the Loyalty balance. Product has the properties name, price and stock. Order has a status and a delivery address, and holds one or more products. Loyalty balance has points.">
        <text class="k" x="0" y="12">CAPABILITIES</text>
        <rect class="cap" x="20" y="20" width="160" height="22" rx="2" />
        <text class="s strong" x="30" y="35">Browse products</text>
        <rect class="cap" x="220" y="20" width="160" height="22" rx="2" />
        <text class="s strong" x="230" y="35">List past orders</text>
        <rect class="cap" x="420" y="20" width="160" height="22" rx="2" />
        <text class="s strong" x="430" y="35">Place order</text>
        <path class="line" d="M100 42 L100 122" />
        <path class="line" d="M280 42 L280 122" />
        <path class="line" d="M480 42 C480 84 330 80 330 122" />
        <path class="line" d="M520 42 L520 122" />
        <text class="mode" x="100" y="86" text-anchor="middle">observes</text>
        <text class="mode" x="280" y="86" text-anchor="middle">observes</text>
        <text class="mode" x="398" y="78" text-anchor="middle">produces</text>
        <text class="mode" x="520" y="86" text-anchor="middle">mutates</text>
        <text class="k" x="0" y="114">RESOURCES</text>
        <rect class="res" x="20" y="122" width="160" height="104" rx="4" />
        <text class="n" x="32" y="142">Product</text>
        <text class="k" x="32" y="162">PROPERTIES</text>
        <text class="r" x="32" y="178">name</text>
        <text class="r" x="32" y="192">price</text>
        <text class="r" x="32" y="206">stock</text>
        <rect class="res" x="220" y="122" width="160" height="104" rx="4" />
        <text class="n" x="232" y="142">Order</text>
        <text class="k" x="232" y="162">PROPERTIES</text>
        <text class="r" x="232" y="178">status</text>
        <text class="r" x="232" y="192">delivery address</text>
        <rect class="res" x="420" y="122" width="160" height="104" rx="4" />
        <text class="n" x="432" y="142">Loyalty balance</text>
        <text class="k" x="432" y="162">PROPERTIES</text>
        <text class="r" x="432" y="178">points</text>
        <path class="rel" d="M220 196 L180 196" />
        <path class="relhead" d="M186 192 L180 196 L186 200" />
        <text class="k" x="200" y="190" text-anchor="middle">1+</text>
        <text class="k" x="200" y="214" text-anchor="middle">HOLDS</text>
      </svg>
    )
  }
  {
    step === "components" && (
      <svg viewBox="0 0 600 176" role="img" aria-label="Level 2, inside the Store: two components, Storefront, which keeps Product, Order and Loyalty balance, and Payments, which keeps Charge. The web shop and the mobile app only present what Storefront offers: they are interfaces, not components.">
        <text class="kb" x="0" y="12">LEVEL 2 · INSIDE THE STORE</text>
        <rect class="frame" x="0.5" y="24" width="598" height="150" rx="4" />
        <text class="k" x="16" y="44">PROVIDER</text>
        <text class="n" x="16" y="62">Store</text>
        <text class="k" x="16" y="88">INTERFACES</text>
        <rect class="step" x="16" y="96" width="112" height="22" rx="3" />
        <text class="s" x="26" y="111">web shop</text>
        <rect class="step" x="16" y="126" width="112" height="22" rx="3" />
        <text class="s" x="26" y="141">mobile app</text>
        <path class="line" d="M128 107 C150 107 150 122 172 122" />
        <path class="line" d="M128 137 C150 137 150 122 172 122" />
        <text class="k" x="172" y="88">COMPONENTS</text>
        <rect class="comp" x="172" y="96" width="222" height="64" rx="4" />
        <text class="k" x="184" y="112">COMPONENT</text>
        <text class="n" x="184" y="129">Storefront</text>
        <rect class="box" x="184" y="136" width="52" height="16" rx="2" />
        <text class="r" x="190" y="147">Product</text>
        <rect class="box" x="240" y="136" width="44" height="16" rx="2" />
        <text class="r" x="246" y="147">Order</text>
        <rect class="box" x="288" y="136" width="94" height="16" rx="2" />
        <text class="r" x="294" y="147">Loyalty balance</text>
        <path class="line" d="M394 128 L424 128" />
        <rect class="comp" x="424" y="96" width="160" height="64" rx="4" />
        <text class="k" x="436" y="112">COMPONENT</text>
        <text class="n" x="436" y="129">Payments</text>
        <rect class="box" x="436" y="136" width="50" height="16" rx="2" />
        <text class="r" x="442" y="147">Charge</text>
      </svg>
    )
  }
  {
    step === "inside" && (
      <svg viewBox="0 0 600 140" role="img" aria-label="Level 2, inside the Store: Storefront is the consumer of Payments, through one interface, the charges API, on an internal boundary. Payments offers Charge order, which produces a Charge.">
        <text class="kb" x="0" y="12">LEVEL 2 · INSIDE THE STORE</text>
        <rect class="box" x="0.5" y="44" width="130" height="44" rx="4" />
        <text class="k" x="12" y="61">CONSUMER</text>
        <text class="n" x="12" y="78">Storefront</text>
        <path class="line" d="M131 66 L220 66" />
        <line class="bnd" x1="220" y1="28" x2="220" y2="104" />
        <circle class="dot" cx="220" cy="66" r="4.5" />
        <text class="s" x="232" y="58">charges API</text>
        <path class="line" d="M225 66 L300 66" />
        <text class="k" x="220" y="120" text-anchor="middle">INTERNAL BOUNDARY</text>
        <rect class="frame" x="300" y="22" width="298" height="88" rx="4" />
        <text class="k" x="316" y="40">PROVIDER</text>
        <text class="n" x="316" y="58">Payments</text>
        <rect class="cap" x="330" y="70" width="120" height="22" rx="3" />
        <text class="s strong" x="340" y="85">Charge order</text>
        <path class="line" d="M450 81 L500 81" />
        <text class="mode" x="475" y="77" text-anchor="middle">produces</text>
        <rect class="box" x="500" y="70" width="84" height="22" rx="3" />
        <text class="s strong" x="510" y="85">Charge</text>
      </svg>
    )
  }
</figure>

<style>
  .ex {
    margin: 16px 0 0;
    padding: 16px 16px 12px;
    border: 1px solid var(--bm-line);
    border-radius: 12px;
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 600px;
    min-width: 460px;
    height: auto;
    overflow: visible;
  }
  svg.mid {
    max-width: 460px;
  }
  svg.narrow {
    max-width: 300px;
    min-width: 0;
    margin: 0 auto;
  }
  .box {
    fill: var(--bm-bg);
    stroke: var(--bm-line2);
    stroke-width: 1;
  }
  .frame {
    fill: none;
    stroke: var(--bm-fg);
    stroke-width: 1.4;
  }
  .comp {
    fill: var(--bm-bg);
    stroke: var(--bm-fg2);
    stroke-width: 1.2;
  }
  .res {
    fill: var(--bm-bg);
    stroke: var(--bm-fg2);
    stroke-width: 1.2;
  }
  .rel,
  .relhead {
    fill: none;
    stroke: var(--bm-fg2);
    stroke-width: 1;
  }
  .cap {
    fill: var(--bm-bg);
    stroke: var(--bm-line2);
    stroke-width: 1;
  }
  .step {
    fill: none;
    stroke: var(--bm-fg3);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  .line {
    fill: none;
    stroke: var(--bm-fg4);
    stroke-width: 1;
  }
  .link {
    fill: none;
    stroke: var(--bm-fg3);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .bnd {
    stroke: var(--bm-fg);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .dot {
    fill: var(--bm-bg);
    stroke: var(--bm-fg);
    stroke-width: 1.5;
  }
  .k,
  .kb {
    fill: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
  }
  .kb {
    fill: var(--bm-fg);
    font-size: 9px;
  }
  .n {
    fill: var(--bm-fg);
    font-family: var(--__sl-font);
    font-size: 13px;
    font-weight: 600;
  }
  .s {
    fill: var(--bm-fg2);
    font-family: var(--__sl-font);
    font-size: 11px;
  }
  .s.strong {
    fill: var(--bm-fg);
    font-weight: 500;
  }
  .r,
  .mode {
    fill: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 9.5px;
  }
  .mode {
    paint-order: stroke;
    stroke: var(--bm-bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
</style>
