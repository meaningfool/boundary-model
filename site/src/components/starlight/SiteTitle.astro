---
// The logo and the site's name, drawn inline so the logo takes the text colour in both themes,
// with its dot in the illustration's ochre.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <rect x="1.5" y="1.5" width="17" height="17" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
    <line x1="10" y1="2.5" x2="10" y2="17.5" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2 2.2"></line>
    <circle cx="10" cy="10" r="2.7" fill="currentColor"></circle>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--bm-fg);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  circle {
    fill: var(--bm-ochre);
  }
  svg {
    width: 20px;
    height: 20px;
    flex: none;
  }
</style>
