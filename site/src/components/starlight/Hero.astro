---
// Page 01's headline, whose second part turns grey, then one solid button and one dashed button.
// The title may hold a <span class="dim"> for the grey part. An action with a `data-copy` attribute
// becomes a button that copies that text, a prompt for your agent; its link is the fallback when
// the browser refuses to copy. The tagline may hold `code` spans.
import { inline } from "../inline";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<header class="hero">
  <h1 id="_top" set:html={title} />
  {tagline && <p class="lede" set:html={inline(tagline)} />}
  {
    actions.length > 0 && (
      <div class="actions">
        {actions.map((a) =>
          a.attrs?.["data-copy"] ? (
            <button class="btn btn-dash" type="button" data-copy={String(a.attrs["data-copy"])} data-href={a.link}>
              <span class="glyph" aria-hidden="true">
                &gt;_
              </span>
              <span class="label">{a.text}</span>
            </button>
          ) : (
            <a class="btn" href={a.link}>
              {a.text}
            </a>
          ),
        )}
      </div>
    )
  }
</header>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".hero [data-copy]")) {
    const label = button.querySelector(".label");
    const text = label?.textContent ?? "";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (label) label.textContent = "Copied. Paste it to your agent.";
        setTimeout(() => label && (label.textContent = text), 2400);
      } catch {
        if (button.dataset.href) location.href = button.dataset.href;
      }
    });
  }
</script>

<style>
  .hero {
    padding-top: 1.5rem;
  }
  h1 {
    margin: 0;
    color: var(--bm-fg);
    font-size: 42px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }
  h1 :global(.dim) {
    color: var(--bm-fg4);
  }
  .lede {
    max-width: 600px;
    margin: 22px 0 0;
    color: var(--bm-fg3);
    font-size: 17px;
    line-height: 1.65;
  }
  .lede :global(code) {
    color: var(--bm-fg);
    font-family: var(--__sl-font-mono);
    font-size: 0.88em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--bm-inv-bg);
    color: var(--bm-inv-fg);
    font: inherit;
    font-size: 14.4px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-dash {
    border: 1px dashed var(--bm-line2);
    background: transparent;
    color: var(--bm-fg2);
  }
  .btn-dash:hover {
    color: var(--bm-fg);
    border-color: var(--bm-fg3);
  }
  .glyph {
    padding: 0 5px;
    border: 1px solid var(--bm-line2);
    border-radius: 5px;
    color: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 12px;
  }
  @media (max-width: 40rem) {
    h1 {
      font-size: 31px;
    }
    .lede {
      font-size: 16px;
    }
  }
</style>
