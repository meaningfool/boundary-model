---
// One live screen of a Store map from public/maps/store/, drawn by scripts/draw-maps.mjs. The
// caption says what to look at or select; the reader can click through the map in place.
//
// A map screen is wider than the text column. On wide screens the frame spreads beyond the column,
// into the space beside it, while its caption keeps the column's width. The frame then draws the
// map at the map's own width and scales it down to fit, but never below 70%, where its text would
// get too small to read. What still does not fit scrolls inside the frame. Without scripts, the
// frame shows the screen unscaled.
interface Props {
  /** The drawn page, such as "step-05" or "map". */
  map: "step-02" | "step-03" | "step-05" | "map" | "after-gift-cards";
  /** The screen's address in the map page, such as "all", "store" or "store/payments". */
  screen?: string;
  /** The frame's height, in pixels of the unscaled map. */
  height?: number;
  /** What the frame shows, for screen readers. */
  title: string;
}

// The width each map's widest screen needs: the step maps have no components, so they are narrower.
const widths = { "step-02": 880, "step-03": 880, "step-05": 880, map: 1500, "after-gift-cards": 1500 };

const { map, screen = "store", height = 700, title } = Astro.props;
const src = `${import.meta.env.BASE_URL}maps/store/${map}.html#${screen}`;
---

<figure class="map-frame not-content">
  <bm-map-frame data-width={widths[map]} data-height={height} style={`--height: ${height}px`}>
    <iframe src={src} title={title} loading="lazy"></iframe>
  </bm-map-frame>
  <figcaption>
    <slot />
    <a href={src} target="_blank" rel="noopener">Open the full screen in a new tab ↗</a>
  </figcaption>
</figure>

<script>
  class MapFrame extends HTMLElement {
    connectedCallback() {
      const iframe = this.querySelector("iframe");
      if (!iframe) return;
      const width = Number(this.dataset.width);
      const height = Number(this.dataset.height);
      const fit = () => {
        const room = this.clientWidth;
        if (!room) return;
        const scale = Math.min(1, Math.max(0.7, room / width));
        iframe.style.width = `${room / scale}px`;
        iframe.style.transform = `scale(${scale})`;
        this.style.height = `${Math.ceil(height * scale)}px`;
      };
      new ResizeObserver(fit).observe(this);
    }
  }
  customElements.define("bm-map-frame", MapFrame);
</script>

<style>
  .map-frame {
    margin: 1.25rem 0 0;
  }
  bm-map-frame {
    display: block;
    height: var(--height);
    overflow: hidden;
    border: 1px solid var(--bm-line);
    border-radius: 12px;
    background: var(--bm-bg);
  }
  iframe {
    display: block;
    width: 100%;
    height: var(--height);
    border: 0;
    transform-origin: 0 0;
  }
  figcaption {
    margin-top: 10px;
    color: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 11.5px;
    line-height: 1.6;
  }
  figcaption a {
    display: inline-block;
    margin-top: 4px;
    color: var(--bm-fg2);
    text-decoration: underline;
    text-decoration-color: var(--bm-line2);
    text-underline-offset: 3px;
  }
  /* Where the text column sits centred, the frame spreads evenly on both sides of it, up to 70rem
     and never past the space between the sidebar and the window's edge. */
  @media (min-width: 72rem) {
    .map-frame {
      --wide: min(70rem, 100vw - var(--sl-sidebar-width) - 4rem);
      margin-inline: calc((100% - var(--wide)) / 2);
    }
    figcaption {
      max-width: var(--sl-content-width);
      margin-inline: auto;
    }
  }
</style>
