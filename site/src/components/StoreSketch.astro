---
// Step 1 of the walkthrough: the Store as one closed box, before anyone uses it.
---

<figure class="sketch not-content">
  <svg viewBox="0 0 360 120" role="img" aria-label="One box, named Store. Nothing else is on the map yet.">
    <rect class="box" x="100.5" y="20.5" width="159" height="79" rx="6"></rect>
    <text class="k" x="116" y="44">PROVIDER</text>
    <text class="n" x="116" y="72">Store</text>
  </svg>
</figure>

<style>
  .sketch {
    margin: 1.25rem 0 0;
    padding: 12px 16px;
    border: 1px solid var(--bm-line);
    border-radius: 12px;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    margin: 0 auto;
  }
  .box {
    fill: var(--bm-bg);
    stroke: var(--bm-fg);
    stroke-width: 1.3;
  }
  .k {
    fill: var(--bm-fg3);
    font-family: var(--__sl-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .n {
    fill: var(--bm-fg);
    font-family: var(--__sl-font);
    font-size: 16px;
    font-weight: 600;
  }
</style>
