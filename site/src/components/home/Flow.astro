---
// Page 01: one vertical flow from a tangled request to issues, each step one level closer to the
// code, each step named after the skill that does it. The scribble beside the request is drawn
// here, from a fixed seed, so it never changes.
const skill = (name: string) => `https://github.com/meaningfool/boundary-model/blob/v${__VERSION__}/skills/${name}/SKILL.md`;
let seed = 7;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const pts = Array.from({ length: 46 }, () => {
  const a = rnd() * Math.PI * 2;
  const r = 18 + rnd() * 50;
  return [Math.cos(a) * r, Math.sin(a) * r];
});
const f = (n: number) => n.toFixed(1);
let tangle = `M${f(pts[0][0])} ${f(pts[0][1])}`;
for (let i = 1; i < pts.length - 1; i++) {
  const [x, y] = pts[i];
  const [nx, ny] = pts[i + 1];
  tangle += ` Q${f(x)} ${f(y)} ${f((x + nx) / 2)} ${f((y + ny) / 2)}`;
}
tangle += " Q70 30 78 62";
---

<div class="flow not-content">
  <span class="axis top">Behavior</span>
  <ol>
    <li class="fstep">
      <span class="fdot open" aria-hidden="true"></span>
      <h3>Start from your intended changes</h3>
      <p class="fsub">A request in your own words, with several changes tangled together.</p>
      <div class="fvis f-request">
        <svg viewBox="-80 -80 160 160" aria-hidden="true"><path d={tangle}></path></svg>
        <p>"Shoppers should be able to pay with gift cards and see what's left on them. In the app too. And can they pay part of an order with a card?"</p>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">1</span>
      <h3>Clarify the behavior changes, from the outside in</h3>
      <p class="fsub"><a href={skill("shape-boundaries")}><code>shape-boundaries</code></a> turns your request into boundary changes, marked against the map: first between your users and the system, then between the parts inside it. Questions about details wait.</p>
      <div class="fvis">
        <div class="bounds">
          <div class="bgroup">
            <div class="bhead">
              <span class="klab">External boundary</span>
              <span class="bname">Shopper ↔ Store<span class="tag">MODIFIED</span></span>
            </div>
            <ul>
              <li><span class="tag">NEW</span><span class="kind">resource</span><b>Gift card</b></li>
              <li><span class="tag">MODIFIED</span><span class="kind">capability</span><b>Place order</b><span class="mode">mutates Gift card</span></li>
              <li><span class="tag">NEW</span><span class="kind">capability</span><b>See gift card balance</b><span class="mode">observes Gift card</span></li>
            </ul>
          </div>
          <div class="bgroup">
            <div class="bhead">
              <span class="klab">Internal boundary</span>
              <span class="bname">Storefront ↔ Payments<span class="tag">MODIFIED</span></span>
            </div>
            <ul>
              <li><span class="tag">MODIFIED</span><span class="kind">capability</span><b>Charge order</b><span class="mode">mutates Gift card</span></li>
              <li><span class="tag">MODIFIED</span><span class="kind">capability</span><b>Refund order</b><span class="mode">mutates Gift card</span></li>
            </ul>
          </div>
        </div>
        <div class="tray">
          <span class="klab">Details, for later</span>
          <span class="chip">Can a gift card pay part of an order?</span>
          <span class="chip">Do gift cards expire?</span>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">2</span>
      <h3>Group the changes into increments you can observe</h3>
      <p class="fsub"><a href={skill("slice")}><code>slice</code></a> groups the boundary changes into slices, each an increment people can observe once it lands. It compares ways to split the change and recommends one, here by interface.</p>
      <div class="fvis slices">
        <div class="sframe">
          <span class="klab">Increment 1 · Pay on the web</span>
          <div class="mcard"><span class="tag">NEW</span>Gift card</div>
          <div class="mcard"><span class="tag">MODIFIED</span>Charge order</div>
          <div class="mcard"><span class="tag cut">SPLIT</span>Place order<small>web shop</small></div>
        </div>
        <div class="sframe">
          <span class="klab">Increment 2 · See the balance</span>
          <div class="mcard"><span class="tag">NEW</span>See gift card balance</div>
        </div>
        <div class="sframe">
          <span class="klab">Increment 3 · Pay in the app</span>
          <div class="mcard"><span class="tag cut">SPLIT</span>Place order<small>mobile app</small></div>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">3</span>
      <h3>Settle the details of each increment</h3>
      <p class="fsub"><a href={skill("refine")}><code>refine</code></a> settles each increment's details, starting from the questions set aside: what people can observe once it works, and how it is built.</p>
      <div class="fvis refined">
        <span class="klab">Increment 1 · Pay on the web</span>
        <div class="rq">
          <span class="klab">From the details</span>
          <span class="chip">Can a gift card pay part of an order?</span>
        </div>
        <div class="rcols">
          <div>
            <span class="klab">Expected behavior</span>
            <p class="rtext">A gift card that holds less than the order pays all it holds. The card pays the rest.</p>
            <div class="receipt" aria-label="Checkout: order 50.00, gift card pays 30.00, card pays 20.00, paid in full.">
              <div><span>Order</span><span>50.00</span></div>
              <div><span>Gift card</span><span>−30.00</span></div>
              <div><span>Card</span><span>−20.00</span></div>
              <div class="paid"><span>Paid in full</span><span aria-hidden="true">✓</span></div>
            </div>
          </div>
          <div>
            <span class="klab">Design decision</span>
            <p class="rtext">The card is authorized before the gift card is charged.</p>
            <p class="rejected"><span class="tag cut">REJECTED</span>Gift card first: a declined card would need the gift card's money put back.</p>
          </div>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">4</span>
      <h3>Turn each increment into an issue</h3>
      <p class="fsub"><a href={skill("to-issues")}><code>to-issues</code></a> turns each increment into an issue that carries its expected behavior and its proof of done, so an agent can build from it.</p>
      <div class="fvis issues">
        <div class="icard"><span class="st"><i></i>Issue</span><b>Pay with a gift card on the web</b><p>Proof of done: pay an order with a gift card in the web shop and see its balance go down.</p></div>
        <div class="icard"><span class="st"><i></i>Issue</span><b>See a gift card's balance</b><p>Proof of done: open a gift card and see what is left on it.</p></div>
        <div class="icard"><span class="st"><i></i>Issue</span><b>Pay with a gift card in the app</b><p>Proof of done: pay an order with a gift card in the mobile app.</p></div>
      </div>
    </li>
  </ol>
  <span class="axis bottom">Implementation details</span>
</div>

<style>
