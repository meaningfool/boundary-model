---
// Page 01: one vertical flow from a tangled request to issues, each step one level closer to the
// code. The scribble beside the request is drawn here, from a fixed seed, so it never changes.
let seed = 7;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const pts = Array.from({ length: 46 }, () => {
  const a = rnd() * Math.PI * 2;
  const r = 18 + rnd() * 50;
  return [Math.cos(a) * r, Math.sin(a) * r];
});
const f = (n: number) => n.toFixed(1);
let tangle = `M${f(pts[0][0])} ${f(pts[0][1])}`;
for (let i = 1; i < pts.length - 1; i++) {
  const [x, y] = pts[i];
  const [nx, ny] = pts[i + 1];
  tangle += ` Q${f(x)} ${f(y)} ${f((x + nx) / 2)} ${f((y + ny) / 2)}`;
}
tangle += " Q70 30 78 62";
---

<div class="flow not-content">
  <span class="axis top">Behavior</span>
  <ol>
    <li class="fstep">
      <span class="fdot open" aria-hidden="true"></span>
      <h3>Start from your intended changes</h3>
      <p class="fsub">A request in your own words, with several changes tangled together.</p>
      <div class="fvis f-request">
        <svg viewBox="-80 -80 160 160" aria-hidden="true"><path d={tangle}></path></svg>
        <p>"Shoppers should be able to pay with gift cards and see what's left on them. In the app too. And can they pay part of an order with a card?"</p>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">1</span>
      <h3>Clarify the behavior changes, from the outside in</h3>
      <p class="fsub">One item for each change in what people can do with the system, marked against the map. Questions about details wait.</p>
      <div class="fvis">
        <div class="cards2">
          <div class="card"><div class="t"><span class="tag">MODIFIED</span>Place order</div><div class="s">Shopper ↔ Store · web shop, mobile app</div></div>
          <div class="card"><div class="t"><span class="tag">NEW</span>See gift card balance</div><div class="s">Shopper ↔ Store · observes Gift card</div></div>
          <div class="card"><div class="t"><span class="tag">MODIFIED</span>Charge order</div><div class="s">Storefront ↔ Payments · mutates Gift card</div></div>
          <div class="card"><div class="t"><span class="tag">NEW</span>Gift card</div><div class="s">Resource kept by Payments</div></div>
        </div>
        <div class="tray">
          <span class="klab">Details, for later</span>
          <span class="chip">Can a gift card pay part of an order?</span>
          <span class="chip">What does an expired card show?</span>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">2</span>
      <h3>Group the changes into increments you can observe</h3>
      <p class="fsub">A change too big for one increment is split, here by interface.</p>
      <div class="fvis slices">
        <div class="sframe">
          <span class="klab">Increment 1 · Pay on the web</span>
          <div class="mcard"><span class="tag">NEW</span>Gift card</div>
          <div class="mcard"><span class="tag">MODIFIED</span>Charge order</div>
          <div class="mcard"><span class="tag cut">SPLIT</span>Place order<small>web shop</small></div>
        </div>
        <div class="sframe">
          <span class="klab">Increment 2 · See the balance</span>
          <div class="mcard"><span class="tag">NEW</span>See gift card balance</div>
        </div>
        <div class="sframe">
          <span class="klab">Increment 3 · Pay in the app</span>
          <div class="mcard"><span class="tag cut">SPLIT</span>Place order<small>mobile app</small></div>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">3</span>
      <h3>Settle the details of each increment</h3>
      <p class="fsub">Its exact expected behavior and its design decisions, starting from the questions set aside earlier.</p>
      <div class="fvis refined">
        <span class="klab">Increment 1 · Pay on the web</span>
        <div>
          <span class="klab">Expected behavior</span>
          <ul>
            <li>A shopper pays for an order with a gift card in the web shop.</li>
            <li>The gift card's balance goes down by the amount paid.</li>
          </ul>
        </div>
        <div>
          <span class="klab">Design decisions</span>
          <ul>
            <li>A gift card can pay part of an order, and a card pays the rest. <span class="from">from details</span></li>
            <li>Each gift card's balance is kept as a list of adjustments.</li>
          </ul>
        </div>
      </div>
    </li>
    <li class="fstep">
      <span class="fdot" aria-hidden="true">4</span>
      <h3>Turn each increment into an issue</h3>
      <p class="fsub">Each issue carries its expected behavior and its proof of done, so an agent can build from it.</p>
      <div class="fvis issues">
        <div class="icard"><span class="st"><i></i>Issue</span><b>Pay with a gift card on the web</b><p>Proof of done: pay an order with a gift card in the web shop and see its balance go down.</p></div>
        <div class="icard"><span class="st"><i></i>Issue</span><b>See a gift card's balance</b><p>Proof of done: open a gift card and see what is left on it.</p></div>
        <div class="icard"><span class="st"><i></i>Issue</span><b>Pay with a gift card in the app</b><p>Proof of done: pay an order with a gift card in the mobile app.</p></div>
      </div>
    </li>
  </ol>
  <span class="axis bottom">Implementation details</span>
</div>

<style>
