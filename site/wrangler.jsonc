{
  // The static build, served as Workers static assets. `npm run deploy` builds and deploys it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundary-model",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
